# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai     # verified from docs.gnani.ai on 2026-11-08
GNANI_STT_MODEL=                          # empty = Prisma v2.5 (verified); prisma-v3.0 is documented but untested here
GNANI_TTS_MODEL=timbre-v2.5               # verified
GNANI_FIXTURE_MODE=false                  # true = UI work without live calls (recorded responses only; UI shows "Fixture mode")
DAILY_GNANI_REQUEST_LIMIT=150             # local ceiling on live Gnani calls per day (0 = no limit)

REASONING_PROVIDER=rules                  # rules | openai_compatible
REASONING_MODEL=                          # openai_compatible only
REASONING_BASE_URL=                       # openai_compatible only
REASONING_API_KEY=                        # openai_compatible only

APP_MODE=demo                             # live_assistance adapter exists but is disabled
APP_ORIGIN=http://127.0.0.1:8000          # the ONLY origin the browser agent may visit
BROWSER_HEADLESS=true                     # false = visible Chromium window for live demos (needs a display)
TIMEZONE=Asia/Kolkata
RETAIN_TRANSCRIPTS=false
